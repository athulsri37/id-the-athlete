# Serves the built site. ${PORT} is filled in from the environment when the
# container starts (see Dockerfile); nginx's own $variables are left alone.
server {
    listen ${PORT};
    root /usr/share/nginx/html;

    # An add_header inside a location replaces any set outside it, so each
    # location lists all of its headers.

    # Vite names built assets by content hash, so they never change. Without
    # "always", the long cache applies only to files that exist: a 404 from
    # a deploy in progress isn't cached for a year.
    location /assets/ {
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The app is one page; anything else gets index.html, revalidated on
    # every visit so a new deploy shows up straight away.
    location / {
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
